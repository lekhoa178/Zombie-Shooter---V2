  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Unity-chan, the Rogue Coder, steps into a twisting dungeon with her glitch-forged
    blade and a small Power Tree at her back. To grow her skills, she must explore
    each level, battling code-beasts and gathering glowing Aether Shards scattered
    in hidden chambers.\n\nWith every shard she finds, a new branch sprouts on her
    Power Tree: one moment it grants a quick dash-slash, the next it builds a simple
    shield of light, or even lets her send out a shockwave to knock foes aside. Every
    dive into the dungeon is a chance to choose which skill to boost next.\n\nAt
    the heart of each area, a boss made of tangled code waits. Unity-chan weaves
    through their slow, heavy attacks, using her upgraded moves to break their defenses.
    When a boss finally falls, it drops a cluster of Aether Shards\u2014enough to
    unlock a powerful new ability.\n\nDungeon after dungeon, Unity-chan grows stronger.
    She combines her dash-slash with explosive fireballs, or uses spinning barriers
    to bounce back enemy fire. Finally, she faces the ultimate Code Architect. Pouring
    every shard she\u2019s earned into her Power Tree, she unleashes her strongest
    move yet\u2014and frees the realm of corrupted code once and for all."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3c7cb113e29ce1a42914508263828b97, type: 2}
  m_sharedMaterial: {fileID: 7605307619548467925, guid: 3c7cb113e29ce1a42914508263828b97, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4294967295
  m_fontColor: {r: 1, g: 1, b: 1, a: 1}
  m_enableVertexGradient: 0
  m_colorMode: 3
